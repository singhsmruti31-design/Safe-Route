# Safe Route — Environment Configuration

# ==============================================================================
# 1. OpenRouteService (ORS) — Dedicated Pedestrian Routing Profile
# ==============================================================================
# VITE_ORS_API_KEY=your_openrouteservice_api_key_here

# ==============================================================================
# 2. Public Service Endpoints (Defaults are free and open)
# ==============================================================================
# VITE_OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# VITE_NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# ==============================================================================
# 3. Safe Route Backend Configuration
# ==============================================================================
VITE_API_BASE_URL=http://localhost:3000

# Backend Authentication & Profile Endpoints
VITE_AUTH_LOGIN_PATH=/api/auth/login
VITE_AUTH_SIGNUP_PATH=/api/auth/signup
VITE_AUTH_LOGOUT_PATH=/api/auth/logout
VITE_AUTH_FORGOT_PASSWORD_PATH=/api/auth/forgot-password
VITE_AUTH_RESET_PASSWORD_PATH=/api/auth/reset-password
VITE_AUTH_VERIFY_EMAIL_PATH=/api/auth/verify-email
VITE_AUTH_ME_PATH=/api/auth/me
VITE_PROFILE_PATH=/api/profile

# Backend Emergency Contacts & Saved Routes Endpoints
VITE_EMERGENCY_CONTACTS_PATH=/api/contacts
VITE_SAVED_ROUTES_PATH=/api/saved-routes

# Future backend endpoints (Community reports)
# VITE_REPORTS_PATH=
